@using System.Data
@{
    ViewData["Title"] = "Panel de Administracion";
    var cambios         = ViewBag.Cambios         as DataTable ?? new DataTable();
    var sesiones        = ViewBag.Sesiones        as DataTable ?? new DataTable();
    var usuariosSistema = ViewBag.UsuariosSistema as DataTable ?? new DataTable();
}

<!-- Tabs -->
<div class="cf-tabs mb-4">
    <a class="cf-tab active" data-bs-toggle="tab" href="#tabCambios">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        Cambios Recientes
    </a>
    <a class="cf-tab" data-bs-toggle="tab" href="#tabSesiones">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Sesiones
    </a>
    <a class="cf-tab" data-bs-toggle="tab" href="#tabUsuarios">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Usuarios Sistema
    </a>
    <a class="cf-tab" data-bs-toggle="tab" href="#tabRespaldo">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Respaldo BD
    </a>
</div>

<div class="tab-content">

    <!-- Cambios -->
    <div class="tab-pane fade show active" id="tabCambios">
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead><tr>
                        <th style="padding-left:20px;">ID</th><th>Usuario</th>
                        <th>Accion</th><th>Campo</th>
                        <th>Valor Anterior</th><th>Valor Nuevo</th><th>Fecha</th>
                    </tr></thead>
                    <tbody>
                        @if (cambios.Rows.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center py-5" style="color:var(--cf-gray-400);">Sin registros.</td></tr>
                        }
                        @foreach (DataRow row in cambios.Rows)
                        {
                            string a = row["Accion"]?.ToString() ?? "";
                            string b = a == "INSERT" ? "cf-badge-green" : a == "UPDATE" ? "cf-badge-yellow" : a == "DELETE" ? "cf-badge-red" : "cf-badge-gray";
                            <tr>
                                <td style="padding-left:20px;color:var(--cf-gray-400);font-size:12px;">@row["ID"]</td>
                                <td><strong>@row["Usuario"]</strong></td>
                                <td><span class="cf-badge @b">@a</span></td>
                                <td style="font-size:13px;">@row["Campo"]</td>
                                <td style="font-size:12px;color:var(--cf-gray-400);">@(row["Valor Anterior"] == DBNull.Value ? "—" : row["Valor Anterior"])</td>
                                <td style="font-size:13px;">@(row["Valor Nuevo"] == DBNull.Value ? "—" : row["Valor Nuevo"])</td>
                                <td style="font-size:12px;color:var(--cf-gray-400);">@row["Fecha"]</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="padding:10px 20px;border-top:1px solid var(--cf-gray-200);font-size:12px;color:var(--cf-gray-400);">
                @cambios.Rows.Count registros
            </div>
        </div>
    </div>

    <!-- Sesiones -->
    <div class="tab-pane fade" id="tabSesiones">
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead><tr>
                        <th style="padding-left:20px;">ID</th><th>Usuario</th>
                        <th>Entrada</th><th>Salida</th><th class="text-center">Duracion</th>
                    </tr></thead>
                    <tbody>
                        @foreach (DataRow row in sesiones.Rows)
                        {
                            string dur = "—";
                            if (row["Fecha Entrada"] != DBNull.Value && row["Fecha Salida"] != DBNull.Value) {
                                var diff = (DateTime)row["Fecha Salida"] - (DateTime)row["Fecha Entrada"];
                                dur = diff.TotalMinutes < 1 ? $"{diff.Seconds}s" : $"{(int)diff.TotalMinutes}m {diff.Seconds}s";
                            }
                            <tr>
                                <td style="padding-left:20px;color:var(--cf-gray-400);font-size:12px;">@row["ID"]</td>
                                <td><strong>@row["Usuario"]</strong></td>
                                <td style="font-size:13px;">@row["Fecha Entrada"]</td>
                                <td style="font-size:13px;color:var(--cf-gray-400);">@(row["Fecha Salida"] == DBNull.Value ? "Activa" : row["Fecha Salida"].ToString())</td>
                                <td class="text-center"><span class="cf-badge cf-badge-gray">@dur</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Usuarios Sistema -->
    <div class="tab-pane fade" id="tabUsuarios">
        <div class="cf-filter-bar mb-3">
            <div class="ms-auto d-flex gap-2">
                <button class="cf-btn cf-btn-primary cf-btn-sm" onclick="abrirModalUS('nuevo')">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    Nuevo Usuario
                </button>
                <button class="cf-btn cf-btn-dark cf-btn-sm" id="btnUSEditar" disabled onclick="abrirModalUS('editar')">Editar</button>
                <button class="cf-btn cf-btn-danger cf-btn-sm" id="btnUSEliminar" disabled onclick="eliminarUS()">Eliminar</button>
            </div>
        </div>
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead><tr>
                        <th style="padding-left:20px;">ID</th><th>Usuario</th>
                        <th>Nombre Completo</th><th class="text-center">Rol</th>
                    </tr></thead>
                    <tbody>
                        @foreach (DataRow row in usuariosSistema.Rows)
                        {
                            string rol = row["rol"]?.ToString() ?? "";
                            <tr class="us-row" style="cursor:pointer;"
                                data-id="@row["id_usuario"]" data-usuario="@row["usuario"]"
                                data-nombre="@(row["nombre"] == DBNull.Value ? "" : row["nombre"])"
                                data-rol="@rol" onclick="seleccionarUS(this)">
                                <td style="padding-left:20px;color:var(--cf-gray-400);font-size:12px;">@row["id_usuario"]</td>
                                <td><strong>@row["usuario"]</strong></td>
                                <td>@(row["nombre"] == DBNull.Value ? "—" : row["nombre"])</td>
                                <td class="text-center">
                                    <span class="cf-badge @(rol == "ADMIN" ? "cf-badge-admin" : "cf-badge-gray")">@rol</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="padding:10px 20px;border-top:1px solid var(--cf-gray-200);font-size:12px;color:var(--cf-gray-400);">
                @usuariosSistema.Rows.Count usuarios del sistema
            </div>
        </div>
    </div>

    <!-- Respaldo -->
    <div class="tab-pane fade" id="tabRespaldo">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="cf-card p-4 text-center">
                    <div style="width:64px;height:64px;border-radius:16px;background:var(--cf-dark);display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--cf-green)" stroke-width="1.8">
                            <ellipse cx="12" cy="5" rx="9" ry="3"/>
                            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/>
                            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                        </svg>
                    </div>
                    <h5 style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;margin-bottom:8px;">Respaldo de Base de Datos</h5>
                    <p style="font-size:13px;color:var(--cf-gray-400);margin-bottom:20px;">Genera un respaldo completo de GymDB en formato <strong>.bak</strong>. El archivo se descargara directamente al navegador.</p>
                    <div class="cf-alert cf-alert-info text-start mb-4" style="font-size:12.5px;">
                        El respaldo puede restaurarse desde SQL Server Management Studio.
                    </div>
                    <div id="panelEstadoRespaldo" class="d-none mb-3"></div>
                    <button class="cf-btn cf-btn-primary w-100" style="justify-content:center;font-size:15px;padding:12px;" id="btnRespaldo" onclick="generarRespaldo()">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                        Generar y Descargar Respaldo
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- MODAL Usuario Sistema -->
<div class="modal fade" id="modalUS" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalUSTitulo">Nuevo Usuario del Sistema</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="usId" />
                <div class="mb-3">
                    <label class="cf-label">Nombre completo</label>
                    <input type="text" id="usNombre" class="cf-input w-100" />
                </div>
                <div class="mb-3">
                    <label class="cf-label">Usuario</label>
                    <input type="text" id="usUsuario" class="cf-input w-100" />
                </div>
                <div class="mb-3">
                    <label class="cf-label">
                        Contrasena
                        <span id="lblClaveNota" style="font-size:11px;color:var(--cf-gray-400);font-weight:400;text-transform:none;letter-spacing:0;">(dejar en blanco = no cambiar)</span>
                    </label>
                    <input type="password" id="usClave" class="cf-input w-100" placeholder="••••••••" />
                </div>
                <div class="mb-3">
                    <label class="cf-label">Rol</label>
                    <select id="usRol" class="cf-select w-100">
                        <option value="USUARIO">USUARIO</option>
                        <option value="ADMIN">ADMIN</option>
                    </select>
                </div>
                <div id="usError" class="cf-alert cf-alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button class="cf-btn cf-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="cf-btn cf-btn-primary" onclick="guardarUS()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<form style="display:none">@Html.AntiForgeryToken()</form>
<script>
    let usSel = null;
    function seleccionarUS(row) {
        document.querySelectorAll('.us-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        usSel = row.dataset;
        document.getElementById('btnUSEditar').disabled   = false;
        document.getElementById('btnUSEliminar').disabled = false;
    }
    function abrirModalUS(modo) {
        const modal = new bootstrap.Modal(document.getElementById('modalUS'));
        document.getElementById('usError').classList.add('d-none');
        if (modo === 'nuevo') {
            document.getElementById('modalUSTitulo').textContent = 'Nuevo Usuario del Sistema';
            ['usId','usNombre','usUsuario','usClave'].forEach(id => document.getElementById(id).value = '');
            document.getElementById('usRol').value = 'USUARIO';
            document.getElementById('usUsuario').readOnly = false;
            document.getElementById('lblClaveNota').style.display = 'none';
        } else {
            if (!usSel) return;
            document.getElementById('modalUSTitulo').textContent = 'Editar Usuario del Sistema';
            document.getElementById('usId').value     = usSel.id;
            document.getElementById('usNombre').value = usSel.nombre;
            document.getElementById('usUsuario').value= usSel.usuario;
            document.getElementById('usClave').value  = '';
            document.getElementById('usRol').value    = usSel.rol;
            document.getElementById('usUsuario').readOnly = true;
            document.getElementById('lblClaveNota').style.display = '';
        }
        modal.show();
    }
    function guardarUS() {
        const id = document.getElementById('usId').value;
        const params = new URLSearchParams({ nombre: document.getElementById('usNombre').value, usuario: document.getElementById('usUsuario').value, clave: document.getElementById('usClave').value, nuevaClave: document.getElementById('usClave').value, rol: document.getElementById('usRol').value, __RequestVerificationToken: getToken() });
        if (id) params.append('idUsuario', id);
        fetch(id ? '@Url.Action("ActualizarUsuarioSistema","Admin")' : '@Url.Action("CrearUsuarioSistema","Admin")', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body: params })
        .then(r => r.json()).then(data => {
            if (data.ok) { bootstrap.Modal.getInstance(document.getElementById('modalUS')).hide(); location.reload(); }
            else { const e = document.getElementById('usError'); e.textContent = data.mensaje; e.classList.remove('d-none'); }
        });
    }
    function eliminarUS() {
        if (!usSel || !confirm(`Eliminar al usuario "${usSel.usuario}"?`)) return;
        fetch('@Url.Action("EliminarUsuarioSistema","Admin")', { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body: `idUsuario=${usSel.id}&__RequestVerificationToken=${getToken()}` })
        .then(r => r.json()).then(data => { if (data.ok) location.reload(); else alert(data.mensaje); });
    }
    function generarRespaldo() {
        const btn = document.getElementById('btnRespaldo');
        const panel = document.getElementById('panelEstadoRespaldo');
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span> Generando...';
        panel.className = 'cf-alert cf-alert-warning';
        panel.textContent = 'Generando respaldo, por favor espera...';
        panel.classList.remove('d-none');
        fetch('@Url.Action("GenerarRespaldo","Admin")', { method:'POST', body: new URLSearchParams({ __RequestVerificationToken: getToken() }) })
        .then(async res => {
            btn.disabled = false;
            btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> Generar y Descargar Respaldo';
            if (res.headers.get('content-type')?.includes('application/json')) {
                const d = await res.json();
                panel.className = 'cf-alert cf-alert-danger';
                panel.textContent = d.mensaje;
                return;
            }
            const blob = await res.blob();
            const fn = res.headers.get('content-disposition')?.match(/filename="?([^"]+)"?/)?.[1] ?? `GymDB_${new Date().toISOString().slice(0,10)}.bak`;
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a'); a.href = url; a.download = fn; a.click(); URL.revokeObjectURL(url);
            panel.className = 'cf-alert cf-alert-success';
            panel.textContent = `Respaldo descargado: ${fn}`;
        });
    }
    function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''; }
</script>
}
