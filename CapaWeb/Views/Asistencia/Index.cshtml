@{
    ViewData["Title"] = "Registrar Asistencia";
}

<style>
    .asis-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #E8ECF2;
        box-shadow: 0 2px 12px rgba(30,40,53,.06);
    }
    .asis-step {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        color: var(--cf-gray-400, #9BA3B0);
        margin-bottom: 12px;
    }
    .asis-member-card {
        background: linear-gradient(135deg, #1E2835 0%, #263445 100%);
        border-radius: 12px;
        padding: 20px 22px;
        color: #fff;
        margin-bottom: 20px;
        position: relative;
        overflow: hidden;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
        border: 2px solid transparent;
    }
    .asis-member-card:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(30,40,53,.15); }
    .asis-member-card.selected { border-color: #8DC63F; }
    .asis-member-card::after {
        content: '';
        position: absolute;
        width: 120px; height: 120px;
        border-radius: 50%;
        background: rgba(141,198,63,.08);
        top: -30px; right: -30px;
    }
    .asis-member-name {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 4px;
    }
    .asis-member-mem {
        font-size: 12px;
        color: rgba(255,255,255,.5);
    }
    .asis-badge-activa  { background:rgba(141,198,63,.2);color:#8DC63F;border:1px solid rgba(141,198,63,.3); }
    .asis-badge-vencida { background:rgba(239,68,68,.2); color:#ef4444;border:1px solid rgba(239,68,68,.3); }
    .asis-badge {
        display: inline-block;
        border-radius: 6px;
        padding: 2px 10px;
        font-size: 11px;
        font-weight: 700;
        font-family: 'Barlow Condensed', sans-serif;
        letter-spacing: .5px;
        margin-top: 8px;
    }
    .asis-checkmark {
        position: absolute;
        top: 16px; right: 16px;
        width: 24px; height: 24px;
        border-radius: 50%;
        background: #8DC63F;
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1;
    }
    .asis-member-card.selected .asis-checkmark { display: flex; }
    .asis-results {
        position: absolute;
        top: calc(100% + 4px);
        left: 0; right: 0;
        background: #fff;
        border: 1px solid #E8ECF2;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,.1);
        z-index: 100;
        max-height: 260px;
        overflow-y: auto;
    }
    .asis-result-item {
        padding: 12px 16px;
        cursor: pointer;
        border-bottom: 1px solid #F4F6F9;
        transition: background .15s;
    }
    .asis-result-item:last-child { border-bottom: none; }
    .asis-result-item:hover { background: #F4F6F9; }
    .asis-result-name { font-size: 14px; font-weight: 600; color: #1E2835; }
    .asis-result-mem  { font-size: 12px; color: #9BA3B0; }
    .asis-clock {
        font-family: 'Barlow Condensed', sans-serif;
        font-size: 42px;
        font-weight: 800;
        color: #1E2835;
        letter-spacing: 2px;
        line-height: 1;
    }
    .asis-date {
        font-size: 13px;
        color: var(--cf-gray-400, #9BA3B0);
        margin-top: 4px;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-6">

        <!-- Reloj -->
        <div class="asis-card p-4 mb-3 text-center">
            <div class="asis-clock" id="reloj">--:--:--</div>
            <div class="asis-date"  id="fecha-hoy">--</div>
        </div>

        <!-- PASO 1: Buscar -->
        <div class="asis-card p-4 mb-3" style="overflow:visible;">
            <div class="asis-step">1. Buscar miembro</div>
            <div style="position:relative;">
                <div class="d-flex gap-2">
                    <input type="text" id="txtBuscar" class="cf-input flex-grow-1"
                           placeholder="Nombre o ID del miembro..."
                           autocomplete="off"
                           oninput="buscarLive(this.value)"
                           onkeydown="if(event.key==='Enter'){event.preventDefault();}" />
                    <button class="cf-btn cf-btn-primary" onclick="buscarLive(document.getElementById('txtBuscar').value)"
                            style="white-space:nowrap;">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                        </svg>
                        Buscar
                    </button>
                </div>
                <div id="dropResultados" class="asis-results d-none"></div>
            </div>
            <div id="alertaBusqueda" class="cf-alert cf-alert-danger d-none mt-3"></div>
        </div>

        <!-- PASO 2: Confirmar -->
        <div id="panelConfirmar" class="d-none">
            <div class="asis-card p-4 mb-3">
                <div class="asis-step">2. Confirmar asistencia</div>

                <div class="asis-member-card selected" id="cardMiembro">
                    <div class="asis-checkmark">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#1E2835" stroke-width="3">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                    </div>
                    <div class="asis-member-name" id="lblNombre">—</div>
                    <div class="asis-member-mem"  id="lblMembresia">—</div>
                    <span class="asis-badge" id="lblEstado"></span>
                </div>

                <div class="d-flex gap-2">
                    <button class="cf-btn cf-btn-primary flex-grow-1" onclick="registrar()"
                            style="justify-content:center;padding:12px;font-size:15px;">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Registrar Entrada
                    </button>
                    <button class="cf-btn cf-btn-outline" onclick="limpiar()">Cancelar</button>
                </div>

                <div id="panelResultado" class="d-none mt-3"></div>
            </div>
        </div>

        <!-- Link a historial -->
        <div class="text-center mt-2">
            <a asp-action="Historial" style="font-size:13px;color:var(--cf-gray-400);text-decoration:none;">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right:4px;">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                Ver historial de asistencias
            </a>
        </div>

    </div>
</div>

@section Scripts {
<form style="display:none">@Html.AntiForgeryToken()</form>
<script>
    let idUsuarioSel = 0;
    let buscarTimer  = null;

    // ── Reloj ────────────────────────────────────────────────
    function actualizarReloj() {
        const ahora = new Date();
        document.getElementById('reloj').textContent =
            ahora.toLocaleTimeString('es-MX', { hour:'2-digit', minute:'2-digit', second:'2-digit' });
        document.getElementById('fecha-hoy').textContent =
            ahora.toLocaleDateString('es-MX', { weekday:'long', year:'numeric', month:'long', day:'numeric' });
    }
    actualizarReloj();
    setInterval(actualizarReloj, 1000);

    // ── Búsqueda en vivo ─────────────────────────────────────
    function buscarLive(valor) {
        clearTimeout(buscarTimer);
        const drop = document.getElementById('dropResultados');
        if (!valor || valor.length < 2) { drop.classList.add('d-none'); return; }

        buscarTimer = setTimeout(() => {
            fetch('@Url.Action("BuscarUsuario","Asistencia")', {
                method:  'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body:    `termino=${encodeURIComponent(valor)}&__RequestVerificationToken=${getToken()}`
            })
            .then(r => r.json())
            .then(data => {
                if (!data.ok || !data.usuarios?.length) {
                    drop.innerHTML = `<div class="asis-result-item" style="color:#9BA3B0;">${data.mensaje ?? 'Sin resultados'}</div>`;
                    drop.classList.remove('d-none');
                    return;
                }
                drop.innerHTML = data.usuarios.map(u => `
                    <div class="asis-result-item"
                         onclick="seleccionar(${u.idUsuario},'${esc(u.nombre)}','${esc(u.membresia)}','${esc(u.estadoMembresia)}')">
                        <div class="asis-result-name">${esc(u.nombre)}</div>
                        <div class="asis-result-mem">${esc(u.membresia)} — <span style="color:${u.estadoMembresia==='ACTIVA'?'#8DC63F':'#ef4444'}">${esc(u.estadoMembresia)}</span></div>
                    </div>`).join('');
                drop.classList.remove('d-none');
            });
        }, 300);
    }

    // ── Seleccionar miembro ──────────────────────────────────
    function seleccionar(id, nombre, membresia, estado) {
        idUsuarioSel = id;
        document.getElementById('dropResultados').classList.add('d-none');
        document.getElementById('alertaBusqueda').classList.add('d-none');
        document.getElementById('lblNombre').textContent   = nombre;
        document.getElementById('lblMembresia').textContent = membresia;
        const badge = document.getElementById('lblEstado');
        badge.textContent  = estado;
        badge.className    = 'asis-badge ' + (estado === 'ACTIVA' ? 'asis-badge-activa' : 'asis-badge-vencida');
        document.getElementById('panelConfirmar').classList.remove('d-none');
        document.getElementById('panelResultado').classList.add('d-none');
    }

    // ── Registrar ────────────────────────────────────────────
    function registrar() {
        if (!idUsuarioSel) return;
        fetch('@Url.Action("Registrar","Asistencia")', {
            method:  'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body:    `idUsuario=${idUsuarioSel}&__RequestVerificationToken=${getToken()}`
        })
        .then(r => r.json())
        .then(data => {
            const p = document.getElementById('panelResultado');
            p.className   = `cf-alert ${data.ok ? 'cf-alert-success' : 'cf-alert-danger'}`;
            p.textContent = data.mensaje;
            p.classList.remove('d-none');
            if (data.ok) setTimeout(() => limpiar(), 2000);
        });
    }

    // ── Limpiar ──────────────────────────────────────────────
    function limpiar() {
        idUsuarioSel = 0;
        document.getElementById('txtBuscar').value = '';
        document.getElementById('panelConfirmar').classList.add('d-none');
        document.getElementById('alertaBusqueda').classList.add('d-none');
        document.getElementById('dropResultados').classList.add('d-none');
        document.getElementById('txtBuscar').focus();
    }

    function esc(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
    }
    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }

    document.addEventListener('click', e => {
        if (!e.target.closest('#dropResultados') && !e.target.closest('#txtBuscar'))
            document.getElementById('dropResultados').classList.add('d-none');
    });

    document.getElementById('txtBuscar').focus();
</script>
}
