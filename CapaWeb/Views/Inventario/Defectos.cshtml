@using CapaDatos
@{
    ViewData["Title"] = "Defectos de Productos";
    var defectos = ViewBag.Defectos as List<Defecto>   ?? new List<Defecto>();
    var productos = ViewBag.Productos as List<Producto> ?? new List<Producto>();
}

<div class="row g-4">
    <!-- Formulario registro -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm" style="border-radius:12px;">
            <div class="card-header bg-transparent fw-bold border-0 pt-4 pb-0">
                Registrar Defecto
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Producto</label>
                    <select id="selProducto" class="form-select">
                        <option value="">Selecciona un producto...</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.ProductoID">@p.Nombre</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Descripción del defecto</label>
                    <input type="text" id="txtDescripcion" class="form-control"
                           placeholder="Describe el defecto..." />
                </div>
                <div class="mb-4">
                    <label class="form-label fw-semibold small">Cantidad afectada</label>
                    <input type="number" id="numCantidad" class="form-control"
                           min="1" value="1" />
                </div>
                <button class="btn btn-danger w-100" onclick="registrarDefecto()">
                    <i class="bi bi-exclamation-triangle me-1"></i> Registrar Defecto
                </button>
                <div id="resultadoDefecto" class="mt-3 d-none"></div>
            </div>
        </div>
    </div>

    <!-- Listado defectos -->
    <div class="col-lg-8">
        <!-- Filtro -->
        <div class="card border-0 shadow-sm mb-3" style="border-radius:12px;">
            <div class="card-body py-2">
                <form method="get" asp-action="Defectos" class="d-flex gap-2 align-items-center">
                    <label class="form-label mb-0 fw-semibold small">Filtrar:</label>
                    <select name="productoID" class="form-select form-select-sm" style="max-width:260px;">
                        <option value="">Todos los productos</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.ProductoID"
                                    selected="@(ViewBag.ProductoActual?.ToString() == p.ProductoID.ToString() ? "selected" : null)">
                                @p.Nombre
                            </option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-primary">Filtrar</button>
                    <a asp-action="Defectos" class="btn btn-sm btn-outline-secondary">Ver todos</a>
                </form>
            </div>
        </div>

        <div class="card border-0 shadow-sm" style="border-radius:12px;">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead style="background:#f8f9fa;">
                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Producto</th>
                                <th>Defecto</th>
                                <th class="text-center">Cant.</th>
                                <th>Registró</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!defectos.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-muted py-4">
                                        <i class="bi bi-check-circle text-success fs-3 d-block mb-2"></i>
                                        No hay defectos registrados.
                                    </td>
                                </tr>
                            }
                            @foreach (var d in defectos)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">
                                        @d.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td class="fw-semibold">@d.ProductoNombre</td>
                                    <td>@d.Descripcion</td>
                                    <td class="text-center">
                                        <span class="badge bg-warning text-dark">@d.CantidadAfectada</span>
                                    </td>
                                    <td class="text-muted small">@d.UsuarioNombre</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function registrarDefecto() {
        const productoID       = document.getElementById('selProducto').value;
        const descripcion      = document.getElementById('txtDescripcion').value.trim();
        const cantidadAfectada = parseInt(document.getElementById('numCantidad').value);

        if (!productoID) { alert('Selecciona un producto.'); return; }
        if (!descripcion) { alert('Escribe la descripción del defecto.'); return; }
        if (cantidadAfectada <= 0) { alert('La cantidad debe ser mayor a cero.'); return; }

        fetch('@Url.Action("RegistrarDefecto", "Inventario")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `productoID=${productoID}&descripcion=${encodeURIComponent(descripcion)}&cantidadAfectada=${cantidadAfectada}&__RequestVerificationToken=${getToken()}`
        })
        .then(r => r.json())
        .then(data => {
            const el = document.getElementById('resultadoDefecto');
            el.className = `alert ${data.ok ? 'alert-success' : 'alert-danger'}`;
            el.textContent = data.mensaje;
            el.classList.remove('d-none');
            if (data.ok) {
                document.getElementById('selProducto').value = '';
                document.getElementById('txtDescripcion').value = '';
                document.getElementById('numCantidad').value = '1';
                setTimeout(() => location.reload(), 1500);
            }
        });
    }

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }
</script>
<form style="display:none">@Html.AntiForgeryToken()</form>
}
