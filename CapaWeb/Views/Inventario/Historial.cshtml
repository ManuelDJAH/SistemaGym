@using CapaDatos
@{
    ViewData["Title"] = "Historial de Movimientos";
    var historial = ViewBag.Historial as List<Movimiento> ?? new List<Movimiento>();
    var productos = ViewBag.Productos as List<Producto>   ?? new List<Producto>();
}

<!-- Filtros -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
    <div class="card-body py-3">
        <form method="get" asp-action="Historial" class="row align-items-end g-3">
            <div class="col-md-3">
                <label class="form-label fw-semibold small">Desde</label>
                <input type="date" name="desde" class="form-control form-control-sm"
                       value="@ViewBag.Desde" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold small">Hasta</label>
                <input type="date" name="hasta" class="form-control form-control-sm"
                       value="@ViewBag.Hasta" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-semibold small">Producto</label>
                <select name="productoID" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var p in productos)
                    {
                        <option value="@p.ProductoID"
                                selected="@(ViewBag.ProductoActual?.ToString() == p.ProductoID.ToString() ? "selected" : null)">
                            @p.Nombre
                        </option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm flex-fill">Buscar</button>
                <a asp-action="Historial" class="btn btn-outline-secondary btn-sm">Todos</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla historial -->
<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background:#f8f9fa;">
                    <tr>
                        <th class="ps-4">Fecha</th>
                        <th>Código</th>
                        <th>Producto</th>
                        <th class="text-center">Tipo</th>
                        <th class="text-center">Cantidad</th>
                        <th>Motivo</th>
                        <th>Registró</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!historial.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                No hay movimientos en el período seleccionado.
                            </td>
                        </tr>
                    }
                    @foreach (var m in historial)
                    {
                        <tr class="@(m.TipoMovimiento == "E" ? "table-success bg-opacity-25" : "table-danger bg-opacity-10")">
                            <td class="ps-4 text-muted small">
                                @m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td><code>@m.ProductoCodigo</code></td>
                            <td class="fw-semibold">@m.ProductoNombre</td>
                            <td class="text-center">
                                @if (m.TipoMovimiento == "E")
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-arrow-down-circle me-1"></i>Entrada
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="bi bi-arrow-up-circle me-1"></i>Salida
                                    </span>
                                }
                            </td>
                            <td class="text-center fw-bold">@m.Cantidad</td>
                            <td class="text-muted small">@(m.Motivo ?? "—")</td>
                            <td class="text-muted small">@m.UsuarioNombre</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (historial.Any())
    {
        <div class="card-footer bg-transparent text-muted small d-flex justify-content-between">
            <span>Total: <strong>@historial.Count</strong> movimientos</span>
            <span>
                Entradas: <strong class="text-success">@historial.Count(m => m.TipoMovimiento == "E")</strong>
                &nbsp;|&nbsp;
                Salidas: <strong class="text-danger">@historial.Count(m => m.TipoMovimiento == "S")</strong>
            </span>
        </div>
    }
</div>
