@using CapaDatos
@{
    ViewData["Title"] = "Alertas de Inventario";
    var alertas = ViewBag.Alertas as List<AlertaInventario> ?? new List<AlertaInventario>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <span class="badge bg-danger fs-6">@alertas.Count alertas pendientes</span>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Volver a Productos
    </a>
</div>

@if (!alertas.Any())
{
    <div class="card border-0 shadow-sm text-center py-5" style="border-radius:12px;">
        <div class="card-body">
            <i class="bi bi-check-circle text-success" style="font-size:3rem;"></i>
            <h5 class="mt-3 text-muted">No hay alertas pendientes</h5>
            <p class="text-muted small">Todos los productos están en niveles correctos.</p>
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var a in alertas)
        {
            <div class="col-md-6" id="alerta-@a.AlertaID">
                <div class="card border-0 shadow-sm h-100 @(a.TipoAlerta == "STOCK_BAJO" ? "border-start border-danger border-3" : "border-start border-warning border-3")"
                     style="border-radius:12px;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                @if (a.TipoAlerta == "STOCK_BAJO")
                                {
                                    <span class="badge bg-danger mb-2">Stock Bajo</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark mb-2">Por Caducar</span>
                                }
                                <h6 class="fw-bold mb-1">@a.Producto</h6>
                                <p class="text-muted small mb-0">@a.Mensaje</p>
                                <p class="text-muted" style="font-size:.75rem;">
                                    @a.FechaAlerta.ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                            <button class="btn btn-sm btn-outline-success"
                                    onclick="atenderAlerta(@a.AlertaID)">
                                <i class="bi bi-check"></i> Atender
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
    function atenderAlerta(alertaID) {
        fetch('@Url.Action("AtenderAlerta", "Inventario")', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `alertaID=${alertaID}&__RequestVerificationToken=${getToken()}`
        })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                const el = document.getElementById(`alerta-${alertaID}`);
                el.style.transition = 'opacity .3s';
                el.style.opacity = '0';
                setTimeout(() => el.remove(), 300);
            } else {
                alert(data.mensaje);
            }
        });
    }

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }
</script>
<form style="display:none">@Html.AntiForgeryToken()</form>
}
