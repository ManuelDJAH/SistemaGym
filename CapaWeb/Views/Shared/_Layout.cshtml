<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SistemaGym — @ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
            :root {
                --sidebar-width: 240px;
                --primary: #0f3460;
                --primary-dark: #16213e;
                --accent: #e94560;
            }

            body {
                background: #f0f2f5;
            }

            /* ── Sidebar ─────────────────────────────────────────── */
            #sidebar {
                width: var(--sidebar-width);
                min-height: 100vh;
                background: var(--primary-dark);
                position: fixed;
                top: 0;
                left: 0;
                display: flex;
                flex-direction: column;
                z-index: 100;
            }

            .sidebar-brand {
                padding: 1.5rem 1.25rem;
                font-size: 1.3rem;
                font-weight: 800;
                color: white;
                letter-spacing: -.5px;
                border-bottom: 1px solid rgba(255,255,255,.1);
            }

                .sidebar-brand span {
                    color: var(--accent);
                }

            .sidebar-nav {
                flex: 1;
                padding: 1rem 0;
            }

            .nav-item .nav-link {
                color: rgba(255,255,255,.7);
                padding: .65rem 1.25rem;
                display: flex;
                align-items: center;
                gap: .75rem;
                border-radius: 0;
                transition: all .2s;
                font-size: .9rem;
            }

                .nav-item .nav-link:hover,
                .nav-item .nav-link.active {
                    color: white;
                    background: rgba(255,255,255,.08);
                    border-left: 3px solid var(--accent);
                }

                .nav-item .nav-link i {
                    font-size: 1.05rem;
                    width: 20px;
                }

            .sidebar-footer {
                padding: 1rem 1.25rem;
                border-top: 1px solid rgba(255,255,255,.1);
            }

            .user-info {
                color: rgba(255,255,255,.6);
                font-size: .8rem;
                margin-bottom: .5rem;
            }

                .user-info strong {
                    color: white;
                    display: block;
                }

            /* ── Main content ─────────────────────────────────────── */
            #main-content {
                margin-left: var(--sidebar-width);
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .topbar {
                background: white;
                padding: .75rem 1.5rem;
                border-bottom: 1px solid #e0e0e0;
                display: flex;
                align-items: center;
                justify-content: space-between;
                position: sticky;
                top: 0;
                z-index: 99;
            }

            .page-content {
                padding: 1.75rem;
                flex: 1;
            }

            .page-title {
                font-weight: 700;
                color: var(--primary-dark);
                font-size: 1.4rem;
            }
    </style>
</head>
<body>

    <!-- ── SIDEBAR ─────────────────────────────────────────────── -->
    <nav id="sidebar">
        <div class="sidebar-brand">
            Sistema<span>Gym</span>
        </div>

        <ul class="sidebar-nav nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
                       asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door"></i> Inicio
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventario" ? "active" : "")"
                       asp-controller="Inventario" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Inventario
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedores" ? "active" : "")"
                       asp-controller="Proveedores" asp-action="Index">
                    <i class="bi bi-truck"></i> Proveedores
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asistencia" ? "active" : "")"
                       asp-controller="Asistencia" asp-action="Index">
                    <i class="bi bi-person-check"></i> Asistencias
                </a>
            </li>

            @if (ViewBag.EsAdmin == true)
            {
                <li class="nav-item mt-2">
                    <div style="color:rgba(255,255,255,.3);font-size:.7rem;padding:.25rem 1.25rem;text-transform:uppercase;letter-spacing:1px;">
                        Administración
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
                           asp-controller="Admin" asp-action="Index">
                        <i class="bi bi-shield-lock"></i> Panel Admin
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")"
                           asp-controller="Usuarios" asp-action="Index">
                        <i class="bi bi-people"></i> Usuarios
                    </a>
                </li>
            }
        </ul>

        <div class="sidebar-footer">
            <div class="user-info">
                <strong>@ViewBag.Usuario</strong>
                @ViewBag.Rol
            </div>
            <a asp-controller="Account" asp-action="Logout"
                   class="btn btn-sm btn-outline-light w-100">
                <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
            </a>
        </div>
    </nav>

    <!-- ── MAIN CONTENT ────────────────────────────────────────── -->
    <div id="main-content">
        <div class="topbar">
            <span class="page-title">@ViewData["Title"]</span>
            <small class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</small>
        </div>

        <div class="page-content">
            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
