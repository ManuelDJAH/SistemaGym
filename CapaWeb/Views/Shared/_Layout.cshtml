<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Ctrl Fitness</title>
    <link rel="icon" type="image/x-icon" href="@Url.Content("~/favicon.ico")" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32x32.png")" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/css/ctrl-fitness.css" rel="stylesheet" />
</head>
<body>

<!-- Overlay para móvil -->
<div id="cf-overlay" onclick="cerrarSidebarMobile()"></div>

<!-- ══ SIDEBAR ══════════════════════════════════════════════════ -->
<nav id="cf-sidebar">

    <!-- Brand: logo imagen con fallback a texto -->
    <a href="/" class="cf-brand">
        <img src="@Url.Content("~/images/logo.png")"
             alt="Ctrl Fitness"
             class="cf-brand-logo"
             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
        <div class="cf-brand-icon" style="display:none;">CF</div>
        <div class="cf-brand-name">
            <div class="line1">Ctrl Fitness</div>
            <div class="line2">Sistema Gym</div>
        </div>
    </a>

    <!-- Nav -->
    <nav class="cf-nav">

        <div class="cf-nav-section">Principal</div>

        <a class="cf-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")"
           asp-controller="Home" asp-action="Index" data-label="Inicio">
            <svg class="cf-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
                <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
            <span class="cf-nav-label">Inicio</span>
        </a>

        <div class="cf-nav-section">Operaciones</div>

        <a class="cf-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Inventario" ? "active" : "")"
           asp-controller="Inventario" asp-action="Index" data-label="Inventario">
            <svg class="cf-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            </svg>
            <span class="cf-nav-label">Inventario</span>
        </a>

        <a class="cf-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Proveedores" ? "active" : "")"
           asp-controller="Proveedores" asp-action="Index" data-label="Proveedores">
            <svg class="cf-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <span class="cf-nav-label">Proveedores</span>
        </a>

        <a class="cf-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Asistencia" ? "active" : "")"
           asp-controller="Asistencia" asp-action="Index" data-label="Asistencias">
            <svg class="cf-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <polyline points="16 11 18 13 22 9"/>
            </svg>
            <span class="cf-nav-label">Asistencias</span>
        </a>

        <a class="cf-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Usuarios" ? "active" : "")"
           asp-controller="Usuarios" asp-action="Index" data-label="Miembros">
            <svg class="cf-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
            </svg>
            <span class="cf-nav-label">Miembros</span>
        </a>

        <a class="cf-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Notificaciones" ? "active" : "")"
           asp-controller="Notificaciones" asp-action="Index" data-label="Notificaciones">
            <svg class="cf-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/>
                <path d="M13.73 21a2 2 0 01-3.46 0"/>
            </svg>
            <span class="cf-nav-label">Notificaciones</span>
        </a>

        @* Panel Admin: se lee desde Session directamente para que funcione en TODOS los controllers *@
        @{
            var rolSesion = Context.Session.GetString("sw_rol") ?? "";
            var esAdmin   = rolSesion == "ADMIN";
        }
        @if (esAdmin)
        {
            <div class="cf-nav-section">Administracion</div>

            <a class="cf-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" ? "active" : "")"
               asp-controller="Admin" asp-action="Index" data-label="Panel Admin">
                <svg class="cf-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
                <span class="cf-nav-label">Panel Admin</span>
            </a>
        }

    </nav>

    <!-- User footer -->
    <div class="cf-sidebar-footer">
        <div class="cf-avatar">@(Context.Session.GetString("sw_usuario")?.Substring(0,1)?.ToUpper() ?? "U")</div>
        <div class="cf-user-info">
            <div class="cf-user-name">@Context.Session.GetString("sw_usuario")</div>
            <div class="cf-user-role">@rolSesion</div>
        </div>
    </div>

</nav>

<!-- ══ MAIN ══════════════════════════════════════════════════════ -->
<div id="cf-main">

    <!-- Topbar -->
    <header id="cf-topbar">
        <!-- Botón menú: colapsa en desktop, abre drawer en móvil -->
        <button id="btn-menu-mobile" onclick="toggleMenu()"
                style="display:none;background:none;border:none;cursor:pointer;padding:4px;margin-right:12px;align-items:center;flex-shrink:0;">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--cf-dark)" stroke-width="2.5">
                <line x1="3" y1="6"  x2="21" y2="6"/>
                <line x1="3" y1="12" x2="21" y2="12"/>
                <line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        <span class="cf-page-title">@ViewData["Title"]</span>
        <div class="cf-topbar-right">
            <span class="cf-date-badge d-none d-sm-inline" id="topbar-fecha">
                <!-- Se rellena por JS con fecha local del cliente -->
            </span>
            <a asp-controller="Account" asp-action="Logout"
               class="cf-btn cf-btn-outline cf-btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                    <line x1="21" y1="12" x2="9" y2="12"/>
                </svg>
                <span class="d-none d-md-inline">Salir</span>
            </a>
        </div>
    </header>

    <!-- Content -->
    <main id="cf-content">
        @RenderBody()
    </main>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    // Fecha local del cliente en topbar
    (function() {
        const el = document.getElementById('topbar-fecha');
        if (el) {
            const ahora = new Date();
            el.textContent = ahora.toLocaleDateString('es-MX', {
                weekday:'short', day:'2-digit', month:'2-digit', year:'numeric'
            });
        }
    })();

    // ── Toggle menú (desktop: colapsa / móvil: drawer) ───────
    function toggleMenu() {
        if (window.innerWidth <= 768) {
            const abierto = document.getElementById('cf-sidebar').classList.contains('mobile-open');
            if (abierto) {
                document.getElementById('cf-sidebar').classList.remove('mobile-open');
                document.getElementById('cf-overlay').classList.remove('visible');
            } else {
                document.getElementById('cf-sidebar').classList.add('mobile-open');
                document.getElementById('cf-overlay').classList.add('visible');
            }
        } else {
            const s = document.getElementById('cf-sidebar');
            s.classList.toggle('collapsed');
            localStorage.setItem('cf-sidebar-collapsed', s.classList.contains('collapsed'));
        }
    }
    function abrirSidebarMobile() { toggleMenu(); }
    function cerrarSidebarMobile() {
        document.getElementById('cf-sidebar').classList.remove('mobile-open');
        document.getElementById('cf-overlay').classList.remove('visible');
    }

    // ── Inicializar ──────────────────────────────────────────
    (function() {
        if (window.innerWidth <= 768) {
            // Móvil: sidebar completamente oculto, sin clase collapsed
            document.getElementById('cf-sidebar').classList.remove('collapsed');
        } else {
            // Desktop: restaurar estado guardado
            if (localStorage.getItem('cf-sidebar-collapsed') === 'true') {
                document.getElementById('cf-sidebar').classList.add('collapsed');
            }
        }
    })();

    // Cerrar sidebar móvil al navegar (click en link)
    document.querySelectorAll('#cf-sidebar .cf-nav-link').forEach(link => {
        link.addEventListener('click', () => {
            if (window.innerWidth <= 768) cerrarSidebarMobile();
        });
    });
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
