@using System.Data
@{
    ViewData["Title"] = "Usuarios / Miembros";
    var dt = ViewBag.Usuarios as DataTable ?? new DataTable();
}

<!-- Barra superior -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:12px;">
    <div class="card-body py-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
                <div class="input-group input-group-sm" style="width:280px;">
                    <input type="text" name="buscar" class="form-control"
                           placeholder="Buscar por nombre..." value="@ViewBag.Buscar" />
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Ver todos</a>
            </form>

            <div class="ms-auto d-flex gap-2">
                <button class="btn btn-sm btn-success" onclick="abrirModal('nuevo')">
                    <i class="bi bi-person-plus me-1"></i> Nuevo
                </button>
                <button class="btn btn-sm btn-primary" id="btnEditar" disabled onclick="abrirModal('editar')">
                    <i class="bi bi-pencil me-1"></i> Editar
                </button>
                <button class="btn btn-sm btn-danger" id="btnEliminar" disabled onclick="eliminar()">
                    <i class="bi bi-trash me-1"></i> Eliminar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Tabla -->
<div class="card border-0 shadow-sm" style="border-radius:12px;">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead style="background:#f8f9fa;">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Nombre</th>
                        <th class="text-center">Edad</th>
                        <th>Correo</th>
                        <th>Telefono</th>
                        <th class="text-center">Membresia</th>
                        <th class="text-center">Registro</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dt.Rows.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-5">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>No hay usuarios registrados.
                        </td></tr>
                    }
                    @foreach (DataRow row in dt.Rows)
                    {
                        <tr class="usuario-row" style="cursor:pointer;"
                            data-id="@row["id_usuario"]"
                            data-nombre="@row["nombre"]"
                            data-edad="@(row["edad"]     == DBNull.Value ? "0" : row["edad"])"
                            data-correo="@(row["correo"]  == DBNull.Value ? "" : row["correo"])"
                            data-telefono="@(row["telefono"] == DBNull.Value ? "" : row["telefono"])"
                            data-membresia="@(row.Table.Columns.Contains("id_membresia") && row["id_membresia"] != DBNull.Value ? row["id_membresia"] : "1")"
                            onclick="seleccionar(this)">
                            <td class="ps-4 text-muted small">@row["id_usuario"]</td>
                            <td class="fw-semibold">@row["nombre"]</td>
                            <td class="text-center">@(row["edad"] == DBNull.Value ? "—" : row["edad"])</td>
                            <td class="small">@(row["correo"]   == DBNull.Value ? "—" : row["correo"])</td>
                            <td class="small">@(row["telefono"] == DBNull.Value ? "—" : row["telefono"])</td>
                            <td class="text-center">
                                <span class="badge bg-primary">@(row.Table.Columns.Contains("id_membresia") && row["id_membresia"] != DBNull.Value ? row["id_membresia"] : "—")</span>
                            </td>
                            <td class="text-center text-muted small">
                                @(row.Table.Columns.Contains("fecha_registro") && row["fecha_registro"] != DBNull.Value
                                    ? ((DateTime)row["fecha_registro"]).ToString("dd/MM/yyyy") : "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer bg-transparent text-muted small">
        Total: <strong>@dt.Rows.Count</strong> usuarios
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalUsuario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content" style="border-radius:12px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="modalTitulo">Nuevo Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="fId" />
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Nombre completo</label>
                    <input type="text" id="fNombre" class="form-control" placeholder="Nombre del miembro" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold small">Edad</label>
                        <input type="number" id="fEdad" class="form-control" min="1" max="120" value="18" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label fw-semibold small">Telefono</label>
                        <input type="text" id="fTelefono" class="form-control" placeholder="Telefono" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Correo</label>
                    <input type="email" id="fCorreo" class="form-control" placeholder="correo@ejemplo.com" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold small">Membresia (ID)</label>
                    <input type="number" id="fMembresia" class="form-control" min="1" value="1" />
                </div>
                <div id="modalError" class="alert alert-danger d-none"></div>
            </div>
            <div class="modal-footer border-0">
                <button class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="guardar()">
                    <i class="bi bi-floppy me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<form style="display:none">@Html.AntiForgeryToken()</form>
<script>
    let seleccionado = null;

    function seleccionar(row) {
        document.querySelectorAll('.usuario-row').forEach(r => r.classList.remove('table-primary'));
        row.classList.add('table-primary');
        seleccionado = row.dataset;
        document.getElementById('btnEditar').disabled   = false;
        document.getElementById('btnEliminar').disabled = false;
    }

    function abrirModal(modo) {
        const modal = new bootstrap.Modal(document.getElementById('modalUsuario'));
        document.getElementById('modalError').classList.add('d-none');

        if (modo === 'nuevo') {
            document.getElementById('modalTitulo').textContent = 'Nuevo Usuario';
            document.getElementById('fId').value       = '';
            document.getElementById('fNombre').value   = '';
            document.getElementById('fEdad').value     = '18';
            document.getElementById('fCorreo').value   = '';
            document.getElementById('fTelefono').value = '';
            document.getElementById('fMembresia').value= '1';
        } else {
            if (!seleccionado) return;
            document.getElementById('modalTitulo').textContent = 'Editar Usuario';
            document.getElementById('fId').value       = seleccionado.id;
            document.getElementById('fNombre').value   = seleccionado.nombre;
            document.getElementById('fEdad').value     = seleccionado.edad;
            document.getElementById('fCorreo').value   = seleccionado.correo;
            document.getElementById('fTelefono').value = seleccionado.telefono;
            document.getElementById('fMembresia').value= seleccionado.membresia;
        }
        modal.show();
    }

    function guardar() {
        const id      = document.getElementById('fId').value;
        const esNuevo = !id;
        const params  = new URLSearchParams({
            nombre:      document.getElementById('fNombre').value,
            edad:        document.getElementById('fEdad').value,
            correo:      document.getElementById('fCorreo').value,
            telefono:    document.getElementById('fTelefono').value,
            idMembresia: document.getElementById('fMembresia').value,
            __RequestVerificationToken: getToken()
        });
        if (!esNuevo) params.append('idUsuario', id);

        fetch(esNuevo ? '@Url.Action("Crear","Usuarios")' : '@Url.Action("Actualizar","Usuarios")',
              { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body: params })
        .then(r => r.json())
        .then(data => {
            if (data.ok) {
                bootstrap.Modal.getInstance(document.getElementById('modalUsuario')).hide();
                location.reload();
            } else {
                const e = document.getElementById('modalError');
                e.textContent = data.mensaje;
                e.classList.remove('d-none');
            }
        });
    }

    function eliminar() {
        if (!seleccionado || !confirm(`Eliminar al usuario "${seleccionado.nombre}"?`)) return;
        fetch('@Url.Action("Eliminar","Usuarios")', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: `idUsuario=${seleccionado.id}&__RequestVerificationToken=${getToken()}`
        }).then(r => r.json()).then(data => {
            if (data.ok) location.reload();
            else alert(data.mensaje);
        });
    }

    function getToken() {
        return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
    }
</script>
}
