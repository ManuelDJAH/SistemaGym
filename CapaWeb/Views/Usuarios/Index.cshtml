@using System.Data
@{
    ViewData["Title"] = "Usuarios / Miembros";
    var usuarios = ViewBag.Usuarios as DataTable ?? new DataTable();
    var membresias = ViewBag.Membresias as DataTable ?? new DataTable();
    var hoy = DateTime.Today;
}

<!-- Barra de búsqueda + acciones -->
<div class="cf-filter-bar mb-3 d-flex flex-wrap gap-2 align-items-center">
    <form method="get" class="d-flex gap-2 align-items-center flex-grow-1">
        <input type="text" name="buscar" value="@ViewBag.Buscar"
               class="cf-input" style="max-width:280px;"
               placeholder="Buscar por nombre..." />
        <button type="submit" class="cf-btn cf-btn-primary cf-btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8" />
                <line x1="21" y1="21" x2="16.65" y2="16.65" />
            </svg>
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
        {
            <a href="@Url.Action("Index", "Usuarios")" class="cf-btn cf-btn-outline cf-btn-sm">Ver todos</a>
        }
    </form>

    <div class="d-flex gap-2 ms-auto">
        <button class="cf-btn cf-btn-primary cf-btn-sm" onclick="abrirModal('nuevo')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <line x1="12" y1="5" x2="12" y2="19" />
                <line x1="5" y1="12" x2="19" y2="12" />
            </svg>
            Nuevo
        </button>
        <button class="cf-btn cf-btn-dark cf-btn-sm" id="btnEditar" disabled onclick="abrirModal('editar')">Editar</button>
        <button class="cf-btn cf-btn-sm" id="btnRenovar" disabled onclick="abrirModalRenovar()"
                style="background:#d97706;color:#fff;border:none;display:flex;align-items:center;gap:6px;padding:6px 14px;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="23 4 23 10 17 10" />
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10" />
            </svg>
            Renovar
        </button>
        <button class="cf-btn cf-btn-danger cf-btn-sm" id="btnEliminar" disabled onclick="eliminarUsuario()">Eliminar</button>
    </div>
</div>

<!-- Tabla -->
<div class="cf-card">
    <div class="table-responsive">
        <table class="cf-table">
            <thead>
                <tr>
                    <th style="padding-left:20px;width:60px;">ID</th>
                    <th>Nombre</th>
                    <th style="width:60px;">Edad</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th style="width:130px;">Membresía</th>
                    <th style="width:120px;">Registro</th>
                    <th style="width:130px;">Vencimiento</th>
                    <th style="width:90px;text-align:center;">Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (usuarios.Rows.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5" style="color:var(--cf-gray-400);">
                            No se encontraron miembros.
                        </td>
                    </tr>
                }
                @foreach (DataRow row in usuarios.Rows)
                {
                    var fVenc = row["fecha_vencimiento"] == DBNull.Value
                                    ? (DateTime?)null
                                    : Convert.ToDateTime(row["fecha_vencimiento"]);
                    var vencida = fVenc.HasValue && fVenc.Value < hoy;
                    var proxVenc = fVenc.HasValue && !vencida && fVenc.Value <= hoy.AddDays(7);
                    var estadoBadge = vencida ? "cf-badge-red"
                                   : proxVenc ? "cf-badge-yellow"
                                              : "cf-badge-green";
                    var estadoTxt = vencida ? "Vencida"
                                   : proxVenc ? "Por vencer"
                                              : "Activa";
                    var memNombre = row["nombre_membresia"]?.ToString() ?? "—";

                    <tr class="usr-row" style="cursor:pointer;"
                        data-id="@row["id_usuario"]"
                        data-nombre="@row["nombre"]"
                        data-edad="@row["edad"]"
                        data-correo="@(row["correo"] == DBNull.Value ? "" : row["correo"])"
                        data-telefono="@(row["telefono"] == DBNull.Value ? "" : row["telefono"])"
                        data-idmembresia="@row["id_membresia"]"
                        onclick="seleccionar(this)">

                        <td style="padding-left:20px;color:var(--cf-gray-400);font-size:12px;">@row["id_usuario"]</td>
                        <td><strong>@row["nombre"]</strong></td>
                        <td style="color:var(--cf-gray-400);">@row["edad"]</td>
                        <td style="font-size:13px;">@(row["correo"] == DBNull.Value ? "—" : row["correo"])</td>
                        <td style="font-size:13px;">@(row["telefono"] == DBNull.Value ? "—" : row["telefono"])</td>
                        <td style="font-size:13px;">@memNombre</td>
                        <td style="font-size:12px;color:var(--cf-gray-400);">
                            @(row["fecha_registro"] == DBNull.Value ? "—"
                              : Convert.ToDateTime(row["fecha_registro"]).ToString("dd/MM/yyyy"))
                        </td>
                        <td style="font-size:12px;@(vencida ? "color:var(--cf-red,#ef4444);" : proxVenc ? "color:#d97706;" : "color:var(--cf-gray-400);")">
                            @(fVenc.HasValue? fVenc.Value.ToString("dd/MM/yyyy") : "—")
                        </td>
                        <td style="text-align:center;">
                            <span class="cf-badge @estadoBadge">@estadoTxt</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div style="padding:10px 20px;border-top:1px solid var(--cf-gray-200);font-size:12px;color:var(--cf-gray-400);">
        Total: @usuarios.Rows.Count usuario@(usuarios.Rows.Count != 1 ? "s" : "")
        @{
            int vencidas = 0;
            foreach (DataRow r in usuarios.Rows)
            {
                if (r["fecha_vencimiento"] != DBNull.Value &&
                    Convert.ToDateTime(r["fecha_vencimiento"]) < hoy) vencidas++;
            }
        }
        @if (vencidas > 0)
        {
            <span style="margin-left:12px;color:var(--cf-red,#ef4444);">
                ⚠ @vencidas membres@(vencidas != 1 ? "ías" : "ía") vencida@(vencidas != 1 ? "s" : "")
            </span>
        }
    </div>
</div>

<!-- ══ MODAL RENOVAR ══════════════════════════════════════════ -->
<div class="modal fade" id="modalRenovar" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Renovar Membresía</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="rId" />
                <div class="mb-3">
                    <label class="cf-label">Miembro</label>
                    <input type="text" id="rNombre" class="cf-input w-100" readonly
                           style="background:var(--cf-gray-50,#f9fafb);color:var(--cf-gray-400);" />
                </div>
                <div class="mb-3">
                    <label class="cf-label">Nueva membresía</label>
                    <select id="rMembresia" class="cf-select w-100">
                        @foreach (DataRow m in membresias.Rows)
                        {
                            <option value="@m["id_membresia"]">
                                @m["nombre_membresia"] — $@string.Format("{0:N0}", m["costo"])
                            </option>
                        }
                    </select>
                </div>
                <div class="cf-alert cf-alert-info" style="font-size:12px;">
                    El nuevo vencimiento se calculará desde <strong>hoy</strong>.
                </div>
                <div id="rError" class="cf-alert cf-alert-danger d-none mt-2"></div>
            </div>
            <div class="modal-footer">
                <button class="cf-btn cf-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="cf-btn cf-btn-primary" onclick="renovar()">Confirmar Renovación</button>
            </div>
        </div>
    </div>
</div>

<!-- ══ MODAL USUARIO ══════════════════════════════════════════ -->
<div class="modal fade" id="modalUsuario" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo">Nuevo Miembro</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="uId" />

                <div class="row g-3">
                    <div class="col-12">
                        <label class="cf-label">Nombre completo</label>
                        <input type="text" id="uNombre" class="cf-input w-100" />
                    </div>
                    <div class="col-4">
                        <label class="cf-label">Edad</label>
                        <input type="number" id="uEdad" class="cf-input w-100" min="1" max="120" />
                    </div>
                    <div class="col-8">
                        <label class="cf-label">Teléfono</label>
                        <input type="text" id="uTelefono" class="cf-input w-100" />
                    </div>
                    <div class="col-12">
                        <label class="cf-label">Correo electrónico</label>
                        <input type="email" id="uCorreo" class="cf-input w-100" />
                    </div>
                    <div class="col-12">
                        <label class="cf-label">Membresía</label>
                        <select id="uMembresia" class="cf-select w-100">
                            @foreach (DataRow m in membresias.Rows)
                            {
                                <option value="@m["id_membresia"]">
                                    @m["nombre_membresia"] — @m["duracion_meses"] mes(es) — $@string.Format("{0:N0}", m["costo"])
                                </option>
                            }
                        </select>
                        <div style="margin-top:6px;font-size:12px;color:var(--cf-gray-400);">
                            La fecha de vencimiento se calcula automáticamente al guardar.
                        </div>
                    </div>
                </div>

                <div id="uError" class="cf-alert cf-alert-danger d-none mt-3"></div>
            </div>
            <div class="modal-footer">
                <button class="cf-btn cf-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="cf-btn cf-btn-primary" onclick="guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form style="display:none">@Html.AntiForgeryToken()</form>
    <script>
        let sel = null;

        function seleccionar(row) {
            document.querySelectorAll('.usr-row').forEach(r => r.classList.remove('selected'));
            row.classList.add('selected');
            sel = row.dataset;
            document.getElementById('btnEditar').disabled = false;
            document.getElementById('btnRenovar').disabled = false;
            document.getElementById('btnEliminar').disabled = false;
        }

        function abrirModal(modo) {
            document.getElementById('uError').classList.add('d-none');
            if (modo === 'nuevo') {
                document.getElementById('modalTitulo').textContent = 'Nuevo Miembro';
                ['uId', 'uNombre', 'uCorreo', 'uTelefono'].forEach(id => document.getElementById(id).value = '');
                document.getElementById('uEdad').value = '';
                document.getElementById('uMembresia').selectedIndex = 0;
            } else {
                if (!sel) return;
                document.getElementById('modalTitulo').textContent = 'Editar Miembro';
                document.getElementById('uId').value = sel.id;
                document.getElementById('uNombre').value = sel.nombre;
                document.getElementById('uEdad').value = sel.edad;
                document.getElementById('uCorreo').value = sel.correo;
                document.getElementById('uTelefono').value = sel.telefono;
                document.getElementById('uMembresia').value = sel.idmembresia;
            }
            new bootstrap.Modal(document.getElementById('modalUsuario')).show();
        }

        function guardar() {
            const id = document.getElementById('uId').value;
            const url = id ? '@Url.Action("Actualizar", "Usuarios")'
                : '@Url.Action("Crear", "Usuarios")';
            const params = new URLSearchParams({
                nombre: document.getElementById('uNombre').value,
                edad: document.getElementById('uEdad').value,
                correo: document.getElementById('uCorreo').value,
                telefono: document.getElementById('uTelefono').value,
                idMembresia: document.getElementById('uMembresia').value,
                __RequestVerificationToken: getToken()
            });
            if (id) params.append('idUsuario', id);

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params
            })
                .then(r => r.json())
                .then(data => {
                    if (data.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('modalUsuario')).hide();
                        location.reload();
                    } else {
                        const e = document.getElementById('uError');
                        e.textContent = data.mensaje;
                        e.classList.remove('d-none');
                    }
                });
        }

        function eliminarUsuario() {
            if (!sel || !confirm(`¿Eliminar a "${sel.nombre}"?`)) return;
            fetch('@Url.Action("Eliminar", "Usuarios")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `idUsuario=${sel.id}&__RequestVerificationToken=${getToken()}`
            })
                .then(r => r.json())
                .then(data => { if (data.ok) location.reload(); else alert(data.mensaje); });
        }

        function abrirModalRenovar() {
            if (!sel) return;
            document.getElementById('rId').value = sel.id;
            document.getElementById('rNombre').value = sel.nombre;
            document.getElementById('rMembresia').value = sel.idmembresia;
            document.getElementById('rError').classList.add('d-none');
            new bootstrap.Modal(document.getElementById('modalRenovar')).show();
        }

        function renovar() {
            const params = new URLSearchParams({
                idUsuario: document.getElementById('rId').value,
                idMembresia: document.getElementById('rMembresia').value,
                __RequestVerificationToken: getToken()
            });
            fetch('@Url.Action("Renovar", "Usuarios")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params
            })
                .then(r => r.json())
                .then(data => {
                    if (data.ok) {
                        bootstrap.Modal.getInstance(document.getElementById('modalRenovar')).hide();
                        location.reload();
                    } else {
                        const e = document.getElementById('rError');
                        e.textContent = data.mensaje;
                        e.classList.remove('d-none');
                    }
                });
        }

        function getToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
        }
    </script>
}
