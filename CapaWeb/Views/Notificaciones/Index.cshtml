@using System.Data
@using ClaseNegocio
@using CapaDatos
@{
    ViewData["Title"] = "Notificaciones";

    var alertasInv  = ViewBag.AlertasInventario as List<AlertaInventario> ?? new();
    var ordenes     = ViewBag.OrdenesRestock    as List<OrdenRestock>     ?? new();
    var memVencidas = ViewBag.MemVencidas       as DataTable              ?? new DataTable();
    var memPorVencer= ViewBag.MemPorVencer      as DataTable              ?? new DataTable();

    int totalInv    = alertasInv.Count;
    int totalRest   = ordenes.Count;
    int totalMemV   = memVencidas.Rows.Count;
    int totalMemP   = memPorVencer.Rows.Count;
    int total       = totalInv + totalRest + totalMemV + totalMemP;
}

<!-- Encabezado -->
<div class="d-flex align-items-center gap-3 mb-4">
    <div>
        <h4 style="font-family:'Barlow Condensed',sans-serif;font-size:22px;font-weight:700;margin:0;">
            Centro de Notificaciones
        </h4>
        <p style="font-size:13px;color:var(--cf-gray-400);margin:0;">
            @if (total == 0)
            { <span>Todo en orden — sin alertas activas.</span> }
            else
            { <span>@total notificación@(total != 1 ? "es" : "") pendiente@(total != 1 ? "s" : "")</span> }
        </p>
    </div>
    @if (total > 0)
    {
        <span style="margin-left:auto;background:var(--cf-red,#ef4444);color:#fff;
                     border-radius:20px;padding:4px 14px;font-size:13px;font-weight:700;">
            @total
        </span>
    }
</div>

@if (total == 0)
{
    <div class="cf-card p-5 text-center">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--cf-green)" stroke-width="1.5" style="margin-bottom:16px;">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
            <polyline points="22 4 12 14.01 9 11.01"/>
        </svg>
        <p style="font-size:15px;font-weight:600;color:var(--cf-dark);margin:0;">Sin notificaciones pendientes</p>
        <p style="font-size:13px;color:var(--cf-gray-400);margin:4px 0 0;">El inventario, restock y membresías están al día.</p>
    </div>
}

@* ══ SECCIÓN 1: MEMBRESÍAS VENCIDAS ══════════════════════════════ *@
@if (memVencidas.Rows.Count > 0)
{
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
            <span style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:#ef4444;">
                Membresías Vencidas
            </span>
            <span style="background:#ef4444;color:#fff;border-radius:12px;padding:1px 10px;font-size:12px;font-weight:700;">
                @memVencidas.Rows.Count
            </span>
        </div>
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead>
                        <tr>
                            <th style="padding-left:20px;">Miembro</th>
                            <th>Membresía</th>
                            <th>Venció el</th>
                            <th>Días vencida</th>
                            <th>Correo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow r in memVencidas.Rows)
                        {
                            var fv   = Convert.ToDateTime(r["fecha_vencimiento"]);
                            var dias = (DateTime.Today - fv).Days;
                            <tr>
                                <td style="padding-left:20px;"><strong>@r["nombre"]</strong></td>
                                <td style="font-size:13px;">@r["nombre_membresia"]</td>
                                <td style="font-size:13px;color:#ef4444;">@fv.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span style="background:#fef2f2;color:#ef4444;border-radius:8px;
                                                 padding:2px 10px;font-size:12px;font-weight:600;">
                                        @dias día@(dias != 1 ? "s" : "")
                                    </span>
                                </td>
                                <td style="font-size:12px;color:var(--cf-gray-400);">
                                    @(r["correo"] == DBNull.Value ? "—" : r["correo"])
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div style="margin-top:8px;">
            <a asp-controller="Usuarios" asp-action="Index"
               class="cf-btn cf-btn-outline cf-btn-sm">
                Ir a Miembros para renovar →
            </a>
        </div>
    </div>
}

@* ══ SECCIÓN 2: MEMBRESÍAS POR VENCER ═══════════════════════════ *@
@if (memPorVencer.Rows.Count > 0)
{
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            <span style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:#d97706;">
                Membresías por Vencer (próximos 7 días)
            </span>
            <span style="background:#d97706;color:#fff;border-radius:12px;padding:1px 10px;font-size:12px;font-weight:700;">
                @memPorVencer.Rows.Count
            </span>
        </div>
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead>
                        <tr>
                            <th style="padding-left:20px;">Miembro</th>
                            <th>Membresía</th>
                            <th>Vence el</th>
                            <th>Días restantes</th>
                            <th>Correo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (DataRow r in memPorVencer.Rows)
                        {
                            var fv   = Convert.ToDateTime(r["fecha_vencimiento"]);
                            var dias = (fv - DateTime.Today).Days;
                            <tr>
                                <td style="padding-left:20px;"><strong>@r["nombre"]</strong></td>
                                <td style="font-size:13px;">@r["nombre_membresia"]</td>
                                <td style="font-size:13px;color:#d97706;">@fv.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span style="background:#fffbeb;color:#d97706;border-radius:8px;
                                                 padding:2px 10px;font-size:12px;font-weight:600;">
                                        @dias día@(dias != 1 ? "s" : "")
                                    </span>
                                </td>
                                <td style="font-size:12px;color:var(--cf-gray-400);">
                                    @(r["correo"] == DBNull.Value ? "—" : r["correo"])
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ══ SECCIÓN 3: ALERTAS DE INVENTARIO ═══════════════════════════ *@
@if (alertasInv.Count > 0)
{
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--cf-green)" stroke-width="2">
                <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
            </svg>
            <span style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:var(--cf-dark);">
                Alertas de Inventario
            </span>
            <span style="background:var(--cf-green);color:var(--cf-dark);border-radius:12px;
                         padding:1px 10px;font-size:12px;font-weight:700;">
                @alertasInv.Count
            </span>
        </div>
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead>
                        <tr>
                            <th style="padding-left:20px;">Producto</th>
                            <th>Tipo de alerta</th>
                            <th>Detalle</th>
                            <th style="text-align:center;">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in alertasInv)
                        {
                            string badgeClass = a.TipoAlerta == "STOCK_BAJO" ? "cf-badge-red" : "cf-badge-yellow";
                            <tr>
                                <td style="padding-left:20px;"><strong>@a.Producto</strong></td>
                                <td><span class="cf-badge @badgeClass">@a.TipoDescripcion</span></td>
                                <td style="font-size:13px;color:var(--cf-gray-400);">@a.Mensaje</td>
                                <td style="text-align:center;">
                                    @if (a.TipoAlerta == "STOCK_BAJO")
                                    {
                                        <a asp-controller="Inventario" asp-action="Movimientos"
                                           class="cf-btn cf-btn-primary cf-btn-sm"
                                           onclick="atenderAlerta(@a.AlertaID, this); return false;">
                                            Registrar entrada →
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="cf-btn cf-btn-outline cf-btn-sm"
                                                onclick="atenderAlerta(@a.AlertaID, this)">
                                            Atender
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* ══ SECCIÓN 4: ÓRDENES DE RESTOCK PENDIENTES ═══════════════════ *@
@if (ordenes.Count > 0)
{
    <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2">
                <rect x="1" y="3" width="15" height="13"/>
                <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
                <circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
            </svg>
            <span style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;color:#6366f1;">
                Órdenes de Restock Pendientes
            </span>
            <span style="background:#6366f1;color:#fff;border-radius:12px;padding:1px 10px;font-size:12px;font-weight:700;">
                @ordenes.Count
            </span>
        </div>
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead>
                        <tr>
                            <th style="padding-left:20px;">Producto</th>
                            <th>Proveedor</th>
                            <th>Cantidad</th>
                            <th>Fecha</th>
                            <th style="text-align:center;">Ir a Restock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in ordenes)
                        {
                            <tr>
                                <td style="padding-left:20px;"><strong>@o.Producto</strong></td>
                                <td style="font-size:13px;">@o.Proveedor</td>
                                <td>
                                    <span class="cf-badge cf-badge-gray">@o.CantidadSolicit uds.</span>
                                </td>
                                <td style="font-size:12px;color:var(--cf-gray-400);">
                                    @o.FechaGenerada.ToString("dd/MM/yyyy")
                                </td>
                                <td style="text-align:center;">
                                    <a asp-controller="Proveedores" asp-action="Restock"
                                       asp-route-estado="PENDIENTE"
                                       class="cf-btn cf-btn-primary cf-btn-sm">Gestionar →</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@section Scripts {
<form style="display:none">@Html.AntiForgeryToken()</form>
<script>
function atenderAlerta(id, btn) {
    fetch('@Url.Action("AtenderAlerta","Notificaciones")', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: `alertaID=${id}&__RequestVerificationToken=${getToken()}`
    })
    .then(r => r.json())
    .then(d => {
        if (d.ok) {
            btn.closest('tr').style.opacity = '0.4';
            // Si es link (stock bajo), navegar después de marcar
            if (btn.tagName === 'A') {
                setTimeout(() => window.location.href = btn.href, 400);
            }
        } else {
            if (btn.tagName !== 'A') { btn.disabled = false; btn.textContent = 'Atender'; }
            alert(d.mensaje);
        }
    });
}
function getToken() {
    return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';
}
</script>
}
