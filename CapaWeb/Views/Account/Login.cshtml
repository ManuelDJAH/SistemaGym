@{
    Layout = null;
    ViewData["Title"] = "Acceso";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ctrl Fitness — Acceso</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <style>
        :root {
            --cf-dark:    #1E2835;
            --cf-darker:  #141C27;
            --cf-green:   #8DC63F;
            --cf-green-d: #6FA52E;
            --cf-glow:    rgba(141,198,63,.18);
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'DM Sans', sans-serif;
            background: var(--cf-darker);
            display: flex;
        }

        /* Left panel */
        .login-left {
            flex: 1;
            background: var(--cf-dark);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 48px;
            position: relative;
            overflow: hidden;
        }

        /* Geometric background decoration */
        .login-left::before {
            content: '';
            position: absolute;
            width: 500px; height: 500px;
            border: 60px solid rgba(141,198,63,.06);
            border-radius: 50%;
            top: -180px; right: -180px;
        }
        .login-left::after {
            content: '';
            position: absolute;
            width: 300px; height: 300px;
            border: 40px solid rgba(141,198,63,.04);
            border-radius: 50%;
            bottom: -100px; left: -80px;
        }

        .login-brand {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 48px;
            position: relative;
            z-index: 1;
        }

        .brand-icon {
            width: 56px; height: 56px;
            background: var(--cf-green);
            border-radius: 14px;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Barlow Condensed', sans-serif;
            font-weight: 800;
            font-size: 22px;
            color: var(--cf-dark);
            box-shadow: 0 4px 20px rgba(141,198,63,.4);
        }

        .brand-text-wrap .brand-name {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 28px;
            font-weight: 800;
            color: #fff;
            letter-spacing: .5px;
            line-height: 1;
        }
        .brand-text-wrap .brand-sub {
            font-size: 11px;
            color: var(--cf-green);
            letter-spacing: 3px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .login-tagline {
            text-align: center;
            position: relative;
            z-index: 1;
            max-width: 320px;
        }

        .login-tagline h1 {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 52px;
            font-weight: 800;
            line-height: 1.0;
            color: #fff;
            margin-bottom: 16px;
            letter-spacing: 1px;
        }

        .login-tagline h1 span { color: var(--cf-green); }

        .login-tagline p {
            color: rgba(255,255,255,.45);
            font-size: 14px;
            line-height: 1.6;
        }

        .feature-list {
            margin-top: 40px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            width: 100%;
            max-width: 280px;
            position: relative;
            z-index: 1;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            color: rgba(255,255,255,.6);
            font-size: 13px;
        }

        .feature-dot {
            width: 8px; height: 8px;
            border-radius: 50%;
            background: var(--cf-green);
            flex-shrink: 0;
        }

        /* Right panel — form */
        .login-right {
            width: 440px;
            background: #fff;
            display: flex;
            flex-direction: column;
            justify-content: center;
            padding: 56px 48px;
        }

        .login-right h2 {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 30px;
            font-weight: 700;
            color: var(--cf-dark);
            margin-bottom: 6px;
        }

        .login-right .sub {
            color: #9BA3B0;
            font-size: 14px;
            margin-bottom: 36px;
        }

        .form-label {
            font-size: 11.5px;
            font-weight: 600;
            color: #5A6272;
            letter-spacing: .6px;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .form-control {
            border: 1.5px solid #E8ECF2;
            border-radius: 8px;
            padding: 11px 16px;
            font-family: 'DM Sans', sans-serif;
            font-size: 14px;
            color: var(--cf-dark);
            transition: border-color .2s, box-shadow .2s;
        }

        .form-control:focus {
            border-color: var(--cf-green);
            box-shadow: 0 0 0 3px rgba(141,198,63,.15);
            outline: none;
        }

        .btn-login {
            background: var(--cf-green);
            color: var(--cf-dark);
            border: none;
            border-radius: 8px;
            padding: 13px;
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 18px;
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
            width: 100%;
            margin-top: 10px;
            transition: background .2s, transform .2s, box-shadow .2s;
        }

        .btn-login:hover {
            background: var(--cf-green-d);
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(141,198,63,.35);
        }

        .btn-login:active { transform: translateY(0); }

        .login-footer {
            margin-top: 36px;
            text-align: center;
            color: #C4C9D4;
            font-size: 12px;
        }

        .login-footer span { color: var(--cf-green); font-weight: 600; }

        /* Error */
        .cf-error {
            background: #FEF2F2;
            color: #991B1B;
            border: 1px solid #FCA5A5;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13.5px;
            margin-bottom: 20px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        @@media (max-width: 768px) {
            .login-left { display: none; }
            .login-right { width: 100%; padding: 40px 28px; }
        }
    </style>
</head>
<body>

    <!-- Left panel -->
    <div class="login-left">
        <div class="login-brand">
            <div class="brand-icon">CF</div>
            <div class="brand-text-wrap">
                <div class="brand-name">Ctrl Fitness</div>
                <div class="brand-sub">Gym Trainer</div>
            </div>
        </div>

        <div class="login-tagline">
            <h1>GESTIONA<br>TU <span>GYM</span><br>AL MAXIMO</h1>
            <p>Control total de inventario, miembros, proveedores y operaciones de tu gimnasio.</p>
        </div>

        <div class="feature-list">
            <div class="feature-item">
                <div class="feature-dot"></div>
                Inventario con codigos de barras EAN-13
            </div>
            <div class="feature-item">
                <div class="feature-dot"></div>
                Gestion de proveedores y restock automatico
            </div>
            <div class="feature-item">
                <div class="feature-dot"></div>
                Registro de asistencias y miembros
            </div>
            <div class="feature-item">
                <div class="feature-dot"></div>
                Panel de administracion con respaldo de BD
            </div>
        </div>
    </div>

    <!-- Right panel — form -->
    <div class="login-right">
        <h2>Bienvenido</h2>
        <p class="sub">Ingresa tus credenciales para acceder al sistema.</p>

        @if (!string.IsNullOrEmpty(ViewBag.Error as string))
        {
            <div class="cf-error">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
                @ViewBag.Error
            </div>
        }

        <form method="post" asp-action="Login" asp-controller="Account">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Usuario</label>
                <input type="text" name="usuario" class="form-control"
                       placeholder="Tu nombre de usuario"
                       autocomplete="username" autofocus />
            </div>

            <div class="mb-2">
                <label class="form-label">Contrasena</label>
                <input type="password" name="clave" class="form-control"
                       placeholder="••••••••"
                       autocomplete="current-password" />
            </div>

            <button type="submit" class="btn-login">INGRESAR AL SISTEMA</button>
        </form>

        <div class="login-footer">
            <span>Ctrl Fitness</span> — Sistema de Gestion Gym &copy; @DateTime.Now.Year
        </div>
    </div>

</body>
</html>
