@{
    ViewData["Title"] = "Inicio";
}

<div class="row g-4">
    <!-- Bienvenida -->
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="background:linear-gradient(135deg,#0f3460,#16213e);color:white;border-radius:12px;">
            <div class="card-body p-4">
                <h4 class="fw-bold mb-1">Bienvenido, @ViewBag.Usuario</h4>
                <p class="mb-0 opacity-75">
                    SistemaGym — Panel de gestión del gimnasio
                </p>
            </div>
        </div>
    </div>

    <!-- Módulos -->
    <div class="col-md-4">
        <a asp-controller="Inventario" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px; transition:.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-box-seam" style="font-size:2.5rem;color:#0f3460;"></i>
                    <h5 class="mt-3 fw-bold">Inventario</h5>
                    <p class="text-muted mb-0 small">Productos, movimientos y alertas</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Proveedores" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px; transition:.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-truck" style="font-size:2.5rem;color:#0f3460;"></i>
                    <h5 class="mt-3 fw-bold">Proveedores</h5>
                    <p class="text-muted mb-0 small">Proveedores y órdenes de restock</p>
                </div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Asistencia" asp-action="Index" class="text-decoration-none">
            <div class="card border-0 shadow-sm h-100" style="border-radius:12px; transition:.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-person-check" style="font-size:2.5rem;color:#0f3460;"></i>
                    <h5 class="mt-3 fw-bold">Asistencias</h5>
                    <p class="text-muted mb-0 small">Registro de asistencia de miembros</p>
                </div>
            </div>
        </a>
    </div>

    @if (ViewBag.EsAdmin == true)
    {
        <div class="col-md-4">
            <a asp-controller="Admin" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm h-100" style="border-radius:12px; transition:.2s;" onmouseover="this.style.transform='translateY(-3px)'" onmouseout="this.style.transform=''">
                    <div class="card-body p-4 text-center">
                        <i class="bi bi-shield-lock" style="font-size:2.5rem;color:#e94560;"></i>
                        <h5 class="mt-3 fw-bold">Panel Admin</h5>
                        <p class="text-muted mb-0 small">Bitácora y respaldo de base de datos</p>
                    </div>
                </div>
            </a>
        </div>
    }
</div>
