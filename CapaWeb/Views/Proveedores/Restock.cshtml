@using CapaDatos
@{
    ViewData["Title"] = "Ordenes de Restock";
    var ordenes = ViewBag.Ordenes as List<OrdenRestock> ?? new List<OrdenRestock>();
}

<!-- Filtro y botones -->
<div class="cf-filter-bar mb-3">
    <form method="get" asp-action="Restock" class="d-flex align-items-center gap-2">
        <label class="cf-label mb-0">Estado:</label>
        <select name="estado" class="cf-select" style="width:150px;" onchange="this.form.submit()">
            <option value="">Todas</option>
            <option value="PENDIENTE" selected="@(ViewBag.Estado == "PENDIENTE" ? "selected" : null)">Pendiente</option>
            <option value="ENVIADA"   selected="@(ViewBag.Estado == "ENVIADA"   ? "selected" : null)">Enviada</option>
            <option value="RECIBIDA"  selected="@(ViewBag.Estado == "RECIBIDA"  ? "selected" : null)">Recibida</option>
            <option value="CANCELADA" selected="@(ViewBag.Estado == "CANCELADA" ? "selected" : null)">Cancelada</option>
        </select>
        <a asp-action="Restock" class="cf-btn cf-btn-outline cf-btn-sm">Todas</a>
    </form>
    <div class="ms-auto d-flex gap-2">
        <button class="cf-btn cf-btn-sm" id="btnEnviada" disabled onclick="abrirEnviada()"
                style="background:#3B82F6;color:#fff;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
            Marcar Enviada
        </button>
        <button class="cf-btn cf-btn-sm" id="btnRecibida" disabled onclick="marcarRecibida()"
                style="background:#16a34a;color:#fff;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            Marcar Recibida
        </button>
        <button class="cf-btn cf-btn-danger cf-btn-sm" id="btnCancelar" disabled onclick="abrirCancelar()">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            Cancelar
        </button>
        <a asp-action="Index" class="cf-btn cf-btn-outline cf-btn-sm">← Proveedores</a>
    </div>
</div>

<!-- Detalle proveedor seleccionado -->
<div id="panelDetalle" class="d-none mb-3">
    <div class="cf-card p-3" style="border-left:3px solid var(--cf-green);">
        <div style="font-size:12px;color:var(--cf-gray-400);" id="lblDetalle"></div>
    </div>
</div>

<!-- Tabla -->
<div class="cf-card">
    <div class="table-responsive">
        <table class="cf-table">
            <thead>
                <tr>
                    <th style="padding-left:20px;width:50px;">#</th>
                    <th>Fecha</th>
                    <th>Producto</th>
                    <th class="text-center">Stock</th>
                    <th class="text-center">Min</th>
                    <th class="text-center">A Pedir</th>
                    <th>Proveedor</th>
                    <th>Teléfono</th>
                    <th class="text-center">Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (!ordenes.Any())
                {
                    <tr><td colspan="9" class="text-center py-5" style="color:var(--cf-gray-400);">
                        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:.3;display:block;margin:0 auto 8px;">
                            <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                        </svg>
                        No hay ordenes de restock.
                    </td></tr>
                }
                @foreach (var o in ordenes)
                {
                    string rowStyle = o.Estado == "PENDIENTE" ? "background:#FFFBEB;"
                                    : o.Estado == "ENVIADA"   ? "background:#EFF6FF;"
                                    : o.Estado == "RECIBIDA"  ? "background:rgba(141,198,63,.05);"
                                    : "";
                    <tr class="orden-row" style="cursor:pointer;@rowStyle"
                        data-id="@o.IdOrden" data-estado="@o.Estado"
                        data-producto="@o.Producto" data-cantidad="@o.CantidadSolicit"
                        data-proveedor="@o.Proveedor" data-tel="@o.TelProveedor"
                        data-correo="@o.CorreoProveedor" data-contacto="@o.ContactoProveedor"
                        onclick="seleccionar(this)">
                        <td style="padding-left:20px;color:var(--cf-gray-400);font-size:12px;">@o.IdOrden</td>
                        <td style="font-size:12px;color:var(--cf-gray-400);">@o.FechaGenerada.ToString("dd/MM/yy HH:mm")</td>
                        <td><strong>@o.Producto</strong></td>
                        <td class="text-center"><span class="cf-badge cf-badge-red">@o.StockActual</span></td>
                        <td class="text-center" style="color:var(--cf-gray-400);font-size:13px;">@o.StockMinimo</td>
                        <td class="text-center"><strong>@o.CantidadSolicit</strong></td>
                        <td style="font-size:13px;">@o.Proveedor</td>
                        <td style="font-size:12px;color:var(--cf-gray-400);">@o.TelProveedor</td>
                        <td class="text-center">
                            @if (o.Estado == "PENDIENTE")
                            { <span class="cf-badge cf-badge-yellow">Pendiente</span> }
                            else if (o.Estado == "ENVIADA")
                            { <span class="cf-badge cf-badge-blue">Enviada</span> }
                            else if (o.Estado == "RECIBIDA")
                            { <span class="cf-badge cf-badge-green">Recibida</span> }
                            else
                            { <span class="cf-badge cf-badge-gray">Cancelada</span> }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL Envío -->
<div class="modal fade" id="modalEnviada" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Envío</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p style="font-size:13px;color:var(--cf-gray-400);" id="lblEnviadaInfo"></p>
                <label class="cf-label">Cantidad a pedir</label>
                <input type="number" id="numCantidad" class="cf-input w-100" min="1" value="1" />
            </div>
            <div class="modal-footer">
                <button class="cf-btn cf-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="cf-btn cf-btn-primary" onclick="confirmarEnviada()">Confirmar</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL Cancelar -->
<div class="modal fade" id="modalCancelar" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cancelar Orden</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label class="cf-label">Motivo</label>
                <input type="text" id="txtMotivo" class="cf-input w-100" placeholder="Motivo de cancelación..." />
            </div>
            <div class="modal-footer">
                <button class="cf-btn cf-btn-outline" data-bs-dismiss="modal">Volver</button>
                <button class="cf-btn cf-btn-danger" onclick="confirmarCancelar()">Cancelar orden</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<form style="display:none">@Html.AntiForgeryToken()</form>
<script>
    let ordenSel = null;

    function seleccionar(row) {
        document.querySelectorAll('.orden-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        ordenSel = row.dataset;

        document.getElementById('lblDetalle').textContent =
            `Proveedor: ${ordenSel.proveedor}  ·  Contacto: ${ordenSel.contacto}  ·  Tel: ${ordenSel.tel}  ·  Correo: ${ordenSel.correo}`;
        document.getElementById('panelDetalle').classList.remove('d-none');

        document.getElementById('btnEnviada').disabled  = ordenSel.estado !== 'PENDIENTE';
        document.getElementById('btnRecibida').disabled = ordenSel.estado !== 'ENVIADA';
        document.getElementById('btnCancelar').disabled = ordenSel.estado !== 'PENDIENTE' && ordenSel.estado !== 'ENVIADA';
    }

    function abrirEnviada() {
        if (!ordenSel) return;
        document.getElementById('lblEnviadaInfo').textContent =
            `${ordenSel.producto} — ${ordenSel.proveedor}`;
        document.getElementById('numCantidad').value = ordenSel.cantidad;
        new bootstrap.Modal(document.getElementById('modalEnviada')).show();
    }

    function confirmarEnviada() {
        fetch('@Url.Action("MarcarEnviada","Proveedores")', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: `idOrden=${ordenSel.id}&cantidad=${document.getElementById('numCantidad').value}&__RequestVerificationToken=${getToken()}`
        }).then(r => r.json()).then(data => {
            bootstrap.Modal.getInstance(document.getElementById('modalEnviada')).hide();
            if (data.ok) location.reload(); else alert(data.mensaje);
        });
    }

    function marcarRecibida() {
        if (!ordenSel || !confirm('¿Marcar esta orden como RECIBIDA?')) return;
        fetch('@Url.Action("MarcarRecibida","Proveedores")', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: `idOrden=${ordenSel.id}&__RequestVerificationToken=${getToken()}`
        }).then(r => r.json()).then(data => {
            if (data.ok) location.reload(); else alert(data.mensaje);
        });
    }

    function abrirCancelar() {
        if (!ordenSel) return;
        document.getElementById('txtMotivo').value = '';
        new bootstrap.Modal(document.getElementById('modalCancelar')).show();
    }

    function confirmarCancelar() {
        fetch('@Url.Action("CancelarOrden","Proveedores")', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: `idOrden=${ordenSel.id}&motivo=${encodeURIComponent(document.getElementById('txtMotivo').value)}&__RequestVerificationToken=${getToken()}`
        }).then(r => r.json()).then(data => {
            bootstrap.Modal.getInstance(document.getElementById('modalCancelar')).hide();
            if (data.ok) location.reload(); else alert(data.mensaje);
        });
    }

    function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''; }
</script>
}
