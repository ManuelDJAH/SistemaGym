@using System.Data
@{
    ViewData["Title"] = "Proveedores";
    var dt         = ViewBag.Proveedores as DataTable ?? new DataTable();
    var categorias = ViewBag.Categorias  as DataTable ?? new DataTable();
}

<!-- Barra superior -->
<div class="cf-filter-bar mb-3">
    <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 flex-wrap">
        <select name="criterio" class="cf-select" style="width:120px;">
            <option value="nombre"   selected="@(ViewBag.Criterio == "nombre"   ? "selected" : null)">Nombre</option>
            <option value="contacto" selected="@(ViewBag.Criterio == "contacto" ? "selected" : null)">Contacto</option>
        </select>
        <input type="text" name="buscar" class="cf-input" style="width:220px;"
               placeholder="Buscar..." value="@ViewBag.Buscar" />
        <button type="submit" class="cf-btn cf-btn-primary cf-btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
        </button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.Buscar as string))
        {
            <a asp-action="Index" class="cf-btn cf-btn-outline cf-btn-sm">Ver todos</a>
        }
    </form>
    <div class="ms-auto d-flex gap-2">
        <button class="cf-btn cf-btn-primary cf-btn-sm" onclick="abrirModal('nuevo')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Nuevo
        </button>
        <button class="cf-btn cf-btn-dark cf-btn-sm" id="btnEditar" disabled onclick="abrirModal('editar')">Editar</button>
        <button class="cf-btn cf-btn-danger cf-btn-sm" id="btnEliminar" disabled onclick="eliminar()">Eliminar</button>
        <a asp-action="Restock" class="cf-btn cf-btn-outline cf-btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="23 4 23 10 17 10"/>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
            </svg>
            Ordenes Restock
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Tabla proveedores -->
    <div class="col-lg-8">
        <div class="cf-card">
            <div class="table-responsive">
                <table class="cf-table">
                    <thead>
                        <tr>
                            <th style="padding-left:20px;">Nombre</th>
                            <th>Contacto</th>
                            <th>Teléfono</th>
                            <th>Correo</th>
                            <th>Dirección</th>
                            <th>Categoría</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (dt.Rows.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center py-5" style="color:var(--cf-gray-400);">
                                No hay proveedores registrados.
                            </td></tr>
                        }
                        @foreach (DataRow row in dt.Rows)
                        {
                            <tr class="prov-row"
                                data-id="@row["id_proveedor"]"
                                data-nombre="@row["nombre"]"
                                data-contacto="@(row["contacto"]  == DBNull.Value ? "" : row["contacto"])"
                                data-telefono="@(row["telefono"]  == DBNull.Value ? "" : row["telefono"])"
                                data-correo="@(row["correo"]      == DBNull.Value ? "" : row["correo"])"
                                data-direccion="@(row["direccion"] == DBNull.Value ? "" : row["direccion"])"
                                data-catid="@(row["id_categoria"] == DBNull.Value ? "" : row["id_categoria"])"
                                onclick="seleccionar(this)">
                                <td style="padding-left:20px;"><strong>@row["nombre"]</strong></td>
                                <td style="font-size:13px;">@(row["contacto"]  == DBNull.Value ? "—" : row["contacto"])</td>
                                <td style="font-size:13px;">@(row["telefono"]  == DBNull.Value ? "—" : row["telefono"])</td>
                                <td style="font-size:12px;color:var(--cf-gray-400);">@(row["correo"]    == DBNull.Value ? "—" : row["correo"])</td>
                                <td style="font-size:12px;color:var(--cf-gray-400);">@(row["direccion"] == DBNull.Value ? "—" : row["direccion"])</td>
                                <td><span class="cf-badge cf-badge-gray">@(row["categoria"] == DBNull.Value ? "—" : row["categoria"])</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div style="padding:10px 20px;border-top:1px solid var(--cf-gray-200);font-size:12px;color:var(--cf-gray-400);">
                Total: @dt.Rows.Count proveedores
            </div>
        </div>
    </div>

    <!-- Panel productos del proveedor -->
    <div class="col-lg-4">
        <div class="cf-card" style="height:100%;">
            <div style="padding:16px 20px;border-bottom:1px solid var(--cf-gray-200);display:flex;align-items:center;justify-content:space-between;">
                <div>
                    <div style="font-family:'Barlow Condensed',sans-serif;font-size:16px;font-weight:700;" id="lblProvNombre">Selecciona un proveedor</div>
                    <div style="font-size:12px;color:var(--cf-gray-400);" id="lblProvSub">para ver sus productos asignados</div>
                </div>
            </div>
            <div id="panelProductos" style="padding:16px;">
                <div style="text-align:center;padding:40px 0;color:var(--cf-gray-400);">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="opacity:.3;display:block;margin:0 auto 8px;">
                        <path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/>
                    </svg>
                    <div style="font-size:13px;">Sin productos asignados</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL -->
<div class="modal fade" id="modalProveedor" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitulo">Nuevo Proveedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="fId" />
                <div class="mb-3">
                    <label class="cf-label">Nombre</label>
                    <input type="text" id="fNombre" class="cf-input w-100" />
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="cf-label">Contacto</label>
                        <input type="text" id="fContacto" class="cf-input w-100" />
                    </div>
                    <div class="col-6">
                        <label class="cf-label">Teléfono</label>
                        <input type="text" id="fTelefono" class="cf-input w-100" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="cf-label">Correo</label>
                    <input type="email" id="fCorreo" class="cf-input w-100" />
                </div>
                <div class="mb-3">
                    <label class="cf-label">Dirección</label>
                    <input type="text" id="fDireccion" class="cf-input w-100" />
                </div>
                <div class="mb-3">
                    <label class="cf-label">Categoría</label>
                    <select id="fCategoria" class="cf-select w-100">
                        @foreach (DataRow cat in categorias.Rows)
                        {
                            <option value="@cat["id_categoria"]">@cat["nombre"]</option>
                        }
                    </select>
                </div>
                <div id="modalError" class="cf-alert cf-alert-danger d-none"></div>
            </div>
            <div class="modal-footer">
                <button class="cf-btn cf-btn-outline" data-bs-dismiss="modal">Cancelar</button>
                <button class="cf-btn cf-btn-primary" onclick="guardar()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<form style="display:none">@Html.AntiForgeryToken()</form>
<script>
    let seleccionado = null;

    function seleccionar(row) {
        document.querySelectorAll('.prov-row').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        seleccionado = row.dataset;
        document.getElementById('btnEditar').disabled   = false;
        document.getElementById('btnEliminar').disabled = false;

        // Mostrar info del proveedor
        document.getElementById('lblProvNombre').textContent = seleccionado.nombre;
        document.getElementById('lblProvSub').textContent    = seleccionado.telefono || seleccionado.correo || '';

        // Cargar productos del proveedor
        cargarProductos(seleccionado.id);
    }

    function cargarProductos(idProveedor) {
        const panel = document.getElementById('panelProductos');
        panel.innerHTML = '<div style="text-align:center;padding:20px;color:var(--cf-gray-400);font-size:13px;">Cargando...</div>';

        fetch('@Url.Action("ProductosDeProveedor","Proveedores")', {
            method:  'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body:    `idProveedor=${idProveedor}&__RequestVerificationToken=${getToken()}`
        })
        .then(r => r.json())
        .then(data => {
            if (!data.productos || data.productos.length === 0) {
                panel.innerHTML = `
                    <div style="text-align:center;padding:30px 0;color:var(--cf-gray-400);">
                        <div style="font-size:13px;margin-bottom:12px;">Sin productos asignados</div>
                        <a href="@Url.Action("Index","Inventario")" style="font-size:12px;color:var(--cf-green);">
                            Ir a Inventario para asignar →
                        </a>
                    </div>`;
                return;
            }
            panel.innerHTML = data.productos.map(p => `
                <div style="display:flex;justify-content:space-between;align-items:center;
                            padding:10px 0;border-bottom:1px solid var(--cf-gray-100,#F4F6F9);">
                    <div>
                        <div style="font-size:13px;font-weight:600;">${p.nombre}</div>
                        <div style="font-size:11px;color:var(--cf-gray-400);">${p.categoria} · $${p.precio}</div>
                    </div>
                    <span class="cf-badge ${p.stockActual <= p.stockMinimo ? 'cf-badge-red' : 'cf-badge-green'}"
                          style="font-size:11px;">
                        ${p.stockActual} uds.
                    </span>
                </div>`).join('');
        });
    }

    function abrirModal(modo) {
        const modal = new bootstrap.Modal(document.getElementById('modalProveedor'));
        document.getElementById('modalError').classList.add('d-none');
        if (modo === 'nuevo') {
            document.getElementById('modalTitulo').textContent = 'Nuevo Proveedor';
            ['fId','fNombre','fContacto','fTelefono','fCorreo','fDireccion'].forEach(id => document.getElementById(id).value = '');
        } else {
            if (!seleccionado) return;
            document.getElementById('modalTitulo').textContent = 'Editar Proveedor';
            document.getElementById('fId').value        = seleccionado.id;
            document.getElementById('fNombre').value    = seleccionado.nombre;
            document.getElementById('fContacto').value  = seleccionado.contacto;
            document.getElementById('fTelefono').value  = seleccionado.telefono;
            document.getElementById('fCorreo').value    = seleccionado.correo;
            document.getElementById('fDireccion').value = seleccionado.direccion;
            if (seleccionado.catid) document.getElementById('fCategoria').value = seleccionado.catid;
        }
        modal.show();
    }

    function guardar() {
        const id = document.getElementById('fId').value;
        const params = new URLSearchParams({
            nombre:      document.getElementById('fNombre').value,
            contacto:    document.getElementById('fContacto').value,
            telefono:    document.getElementById('fTelefono').value,
            correo:      document.getElementById('fCorreo').value,
            direccion:   document.getElementById('fDireccion').value,
            idCategoria: document.getElementById('fCategoria').value,
            __RequestVerificationToken: getToken()
        });
        if (id) params.append('idProveedor', id);

        fetch(id ? '@Url.Action("Actualizar","Proveedores")' : '@Url.Action("Crear","Proveedores")',
              { method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'}, body: params })
        .then(r => r.json())
        .then(data => {
            if (data.ok) { bootstrap.Modal.getInstance(document.getElementById('modalProveedor')).hide(); location.reload(); }
            else { const e = document.getElementById('modalError'); e.textContent = data.mensaje; e.classList.remove('d-none'); }
        });
    }

    function eliminar() {
        if (!seleccionado || !confirm(`Eliminar "${seleccionado.nombre}"?`)) return;
        fetch('@Url.Action("Eliminar","Proveedores")', {
            method:'POST', headers:{'Content-Type':'application/x-www-form-urlencoded'},
            body: `idProveedor=${seleccionado.id}&__RequestVerificationToken=${getToken()}`
        }).then(r => r.json()).then(data => { if (data.ok) location.reload(); else alert(data.mensaje); });
    }

    function getToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? ''; }
</script>
}
